# From https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form messages are delivered.
# Without a verified domain, Resend only delivers to the email you signed up with.
CONTACT_TO_EMAIL=

# Optional. Defaults to "Portfolio <onboarding@resend.dev>".
# Once you verify a domain in Resend, use e.g. "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
